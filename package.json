{
  "name": "fishcheckbot",
  "version": "2.0.0",
  "description": "Telegram-бот учёта переработки рыбы в ресторанной сети",
  "type": "module",
  "main": "dist/bot/index.js",
  "scripts": {
    "dev": "tsx watch src/bot/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/bot/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "keywords": [
    "telegram-bot",
    "typescript",
    "mongodb",
    "telegraf"
  ],
  "author": "LDRION",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "vitest related --run"
    ]
  },
  "dependencies": {
    "@types/node": "^25.5.2",
    "dotenv": "^17.4.0",
    "mongoose": "^9.4.1",
    "telegraf": "^4.16.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "vitest": "^4.1.2"
  }
}
